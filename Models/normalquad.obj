mtllib normalquad.mtl
# A subdivided quad in the XY plane. Subdivision matters: normal mapping
# needs real tangents, and a single quad has degenerate UV derivatives.
v -1.0 -1.0 0.0
v  1.0 -1.0 0.0
v  1.0  1.0 0.0
v -1.0  1.0 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
# Tangent along +U (screen-right when viewed from +Z), bitangent along +V.
vn 0.0 0.0 1.0
vt 1.0 0.0
f 1/1/1 2/2/1 3/3/1 4/4/1
